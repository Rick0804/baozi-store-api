      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('produtoId', json.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Criar Pedido",
