{
  "info": {
    "name": "Baozi Store API",
    "description": "Coleção Postman para testar a API REST do trabalho de Desenvolvimento Web Back-End.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clienteId",
      "value": "1"
    },
    {
      "key": "produtoId",
      "value": "1"
    },
    {
      "key": "pedidoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Criar Cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"HenriqueNunes000000\",\n  \"clienteDesde\": \"2026-06-29\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('clienteId', json.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Criar Produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Baozi de Frango\",\n  \"preco\": 12.50,\n  \"estoque\": true\n}"
